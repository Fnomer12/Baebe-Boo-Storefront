NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://baebe-boo.jtechinnovations.tech
NEXT_PUBLIC_ENABLE_DEMO_CATALOG=false
SUPABASE_SECRET_KEY=
# Paystack SECRET key only — starts with sk_test_ or sk_live_.
# This is NOT the Supabase key. It is sent as a Bearer token to api.paystack.co
# and is the HMAC key for webhook signature checks, so pasting the wrong secret
# here leaks that credential to a third party.
PAYSTACK_SECRET_KEY=

# Email. Leave EMAIL_PROVIDER unset (or "log") and every send is silently
# simulated — sendEmail returns success and nothing is delivered.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be an address on a domain verified at resend.com/domains.
# onboarding@resend.dev works with no DNS setup but can ONLY deliver to the
# Resend account owner, so it must not be used in production.
EMAIL_FROM=Baebe Boo <hello@baebe-boo.jtechinnovations.tech>
# Where customer replies go. Mail is sent FROM a no-reply address, so without
# this a reply to a receipt or a sign-in code goes nowhere. Unlike EMAIL_FROM
# this does NOT have to be on a Resend-verified domain — any mailbox that is
# actually read will do. Leave it empty and receipts simply stop offering an
# address, rather than printing one nobody can receive on.
EMAIL_REPLY_TO=
# Printed on the web and PDF receipts. Falls back to EMAIL_REPLY_TO.
SUPPORT_EMAIL=
# Read at request time, unlike NEXT_PUBLIC_WHATSAPP_NUMBER which the bundler
# inlines at build time — so this one can be changed without a rebuild.
SUPPORT_WHATSAPP_NUMBER=

# SMS via Frog by Wigal (https://frog.wigal.com.gh). Keep these server-only.
# FROG_SENDER_ID must be an approved sender ID in your Frog account.
FROG_API_KEY=
FROG_USERNAME=
FROG_SENDER_ID=

# Shared secret for the scheduled-campaign endpoint (/api/cron/campaigns).
# The schedule itself lives in the DATABASE (Supabase pg_cron + pg_net) rather
# than on this host, so it survives a move to Vercel or anywhere else. The same
# value must be stored in Supabase Vault as `campaign_cron_secret` — the cron
# job reads it from there, because cron.job is readable by anyone who can see
# the cron schema and an inlined token there is a credential in plaintext.
# Generate with: openssl rand -base64 32
CRON_SECRET=

NEXT_PUBLIC_WHATSAPP_NUMBER=233000000000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
